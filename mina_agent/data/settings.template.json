{
  "_comment": "Session settings for harness-invoked Claude sessions. `mina-agent discuss` passes this via `claude --settings`; headless phases derive SDK options (disallowed_tools, hooks) from it. It is never written into the repo's .claude/. The PreToolUse Bash entries are gated by Claude Code's own permission-rule matcher via the hook `if` field and only attach context; the deny rules are the enforcement. Docs: code.claude.com/docs/en/hooks (Hook object fields, JSON stdout output format), code.claude.com/docs/en/permissions (Read and Edit; Bash), code.claude.com/docs/en/cli-reference (--settings).",
  "permissions": {
    "deny": [
      "Edit(/flake.nix)",
      "Edit(/flake.lock)",
      "Edit(/opam.export)",
      "Edit(/nix/**)",
      "Edit(**/dune-project)",
      "Edit(**/*.opam)",
      "Edit(**/rust-toolchain*)",
      "Edit(**/Cargo.toml)",
      "Edit(**/Cargo.lock)",
      "Edit(/_build/**)",
      "Edit(/_opam/**)",
      "Edit(/opam_switches/**)",
      "Edit(/.envrc)",
      "Edit(/src/lib/crypto/proof-systems/**)",
      "Edit(/src/lib/crypto/kimchi_bindings/stubs/src/**)",
      "Edit(/src/lib/crypto/kimchi_bindings/stubs/kimchi-stubs-vendors/**)",
      "Bash(dune *)",
      "Bash(opam *)",
      "Bash(nix *)",
      "Bash(nix-env *)",
      "Bash(nix-shell *)",
      "Bash(cargo *)",
      "Bash(rustup *)",
      "Bash(make *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mina-agent hook post-edit",
            "timeout": 600,
            "statusMessage": "harness: type-checking edited file"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(dune *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(dune)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(ocamlfind *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(ocamlfind)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(ocamlopt *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(ocamlopt)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(ocamlc *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(ocamlc)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(opam *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(opam)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix-env *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix-env)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix-shell *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix-shell)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix-build *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(nix-build)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(cargo *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(cargo)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(rustup *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(rustup)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(make *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(make)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(pip *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(pip)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(pip3 *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(pip3)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(./scripts/update-opam-switch.sh *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(./scripts/update-opam-switch.sh)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(scripts/update-opam-switch.sh *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(scripts/update-opam-switch.sh)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(./scripts/pin-external-packages.sh *)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(./scripts/pin-external-packages.sh)",
            "command": "mina-agent hook pre-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "mina-agent hook session-start",
            "timeout": 120,
            "statusMessage": "harness: deriving library graph"
          }
        ]
      }
    ]
  }
}
