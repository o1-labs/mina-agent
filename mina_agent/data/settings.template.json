            "command": "mina-agent hook pre-bash --why env",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(./scripts/update-opam-switch.sh)",
            "command": "mina-agent hook pre-bash --why env",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(scripts/update-opam-switch.sh *)",
            "command": "mina-agent hook pre-bash --why env",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(scripts/update-opam-switch.sh)",
            "command": "mina-agent hook pre-bash --why env",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(./scripts/pin-external-packages.sh *)",
            "command": "mina-agent hook pre-bash --why env",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(./scripts/pin-external-packages.sh)",
            "command": "mina-agent hook pre-bash --why env",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "mina-agent hook session-start",
            "timeout": 120,
            "statusMessage": "harness: deriving library graph"
          }
        ]
      }
    ]
  }
}
