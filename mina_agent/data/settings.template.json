{
  "_comment": "Session settings for harness-invoked Claude sessions. `mina-agent discuss` passes this via `claude --settings`; headless phases derive SDK options (disallowed_tools, hooks) from it. It is never written into the repo's .claude/. The Bash deny rules are the enforcement, evaluated by Claude Code's own permission-rule matcher. agent.session_settings() adds one PreToolUse Bash hook entry per Bash deny rule, gated by the same rule through the hook `if` field, that only attaches context; the deny list is the single source of truth. Docs: code.claude.com/docs/en/hooks (Hook object fields, JSON stdout output format), code.claude.com/docs/en/permissions (Read and Edit; Bash), code.claude.com/docs/en/cli-reference (--settings). includeCoAuthoredBy=false: commits made in a harness session are the user's; no Co-Authored-By or Generated-with lines.",
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Edit(/flake.nix)",
      "Edit(/flake.lock)",
      "Edit(/opam.export)",
      "Edit(/nix/**)",
      "Edit(**/dune-project)",
      "Edit(**/*.opam)",
      "Edit(**/rust-toolchain*)",
      "Edit(**/Cargo.toml)",
      "Edit(**/Cargo.lock)",
      "Edit(/_build/**)",
      "Edit(/_opam/**)",
      "Edit(/opam_switches/**)",
      "Edit(/.envrc)",
      "Edit(/src/lib/crypto/proof-systems/**)",
      "Edit(/src/lib/crypto/kimchi_bindings/stubs/src/**)",
      "Edit(/src/lib/crypto/kimchi_bindings/stubs/kimchi-stubs-vendors/**)",
      "Bash(dune *)",
      "Bash(opam *)",
      "Bash(nix *)",
      "Bash(nix-build *)",
      "Bash(nix-env *)",
      "Bash(nix-shell *)",
      "Bash(cargo *)",
      "Bash(rustup *)",
      "Bash(make *)",
      "Bash(ocamlfind *)",
      "Bash(ocamlopt *)",
      "Bash(ocamlc *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(./scripts/update-opam-switch.sh *)",
      "Bash(scripts/update-opam-switch.sh *)",
      "Bash(./scripts/pin-external-packages.sh *)",
      "Bash(dune)",
      "Bash(opam)",
      "Bash(nix)",
      "Bash(nix-build)",
      "Bash(nix-env)",
      "Bash(nix-shell)",
      "Bash(cargo)",
      "Bash(rustup)",
      "Bash(make)",
      "Bash(ocamlfind)",
      "Bash(ocamlopt)",
      "Bash(ocamlc)",
      "Bash(pip)",
      "Bash(pip3)",
      "Bash(./scripts/update-opam-switch.sh)",
      "Bash(scripts/update-opam-switch.sh)",
      "Bash(./scripts/pin-external-packages.sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "mina-agent hook post-edit",
            "timeout": 600,
            "statusMessage": "harness: type-checking edited file"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "mina-agent hook session-start",
            "timeout": 120,
            "statusMessage": "harness: deriving library graph"
          }
        ]
      }
    ]
  }
}
